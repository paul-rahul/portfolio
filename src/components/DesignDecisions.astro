---
interface Decision {
	decision: string;
	rationale: string;
}

interface Props {
	decisions: Decision[];
}

const { decisions } = Astro.props;
---

{
	decisions.length > 0 && (
		<ul class="design-decisions">
			{decisions.map((item) => (
				<li class="design-decisions__item">
					<span class="design-decisions__leader" aria-hidden="true" />
					<span class="design-decisions__decision">{item.decision}</span>
					<span class="design-decisions__rationale">{item.rationale}</span>
				</li>
			))}
		</ul>
	)
}

<style>
	.design-decisions {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.design-decisions__item {
		position: relative;
		padding-left: var(--space-5);
	}

	.design-decisions__leader {
		position: absolute;
		left: 0;
		top: 0.35em;
		bottom: 0.35em;
		width: 1px;
		background: var(--color-cord-tension);
	}

	.design-decisions__decision {
		display: block;
		font-weight: var(--font-weight-semibold);
	}

	.design-decisions__rationale {
		display: block;
		margin-top: var(--space-1);
		font-size: var(--font-body-sm);
		color: var(--color-muted-foreground);
	}
</style>
