---
interface Props {
	href: string;
	rel?: string;
	class?: string;
}

const { href, rel, class: className } = Astro.props;
---

<a class:list={["leader-link", className]} href={href} rel={rel}>
	<span class="leader-link__leader" aria-hidden="true" />
	<slot />
</a>

<style>
	.leader-link {
		position: relative;
		display: flex;
		flex-direction: column;
		padding-left: var(--space-5);
		text-decoration: none;
		color: var(--color-foreground);
	}

	.leader-link__leader {
		position: absolute;
		left: 0;
		top: 0.35em;
		bottom: 0.35em;
		width: 1px;
		background: var(--color-rod-secondary);
	}

	.leader-link:hover .leader-link__leader {
		background: var(--color-cord-tension);
	}
</style>
