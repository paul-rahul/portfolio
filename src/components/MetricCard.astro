---
interface Props {
	value: string;
	whatItMeasured: string;
	source: string;
}

const { value, whatItMeasured, source } = Astro.props;
---

<div class="metric-card">
	<span class="metric-card__leader" aria-hidden="true"></span>
	<span class="metric-card__value">{value}</span>
	<span class="metric-card__what">{whatItMeasured}</span>
	<span class="metric-card__source">SOURCE: {source}</span>
</div>

<style>
	/* Same leader-line grammar as the home page's quick-fact strip — a
	   metric is another instrument readout hanging off what proves it. */
	.metric-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding-top: var(--space-4);
	}

	.metric-card__leader {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: var(--space-4);
		background: var(--color-rod-secondary);
	}

	.metric-card__value {
		font-size: var(--font-heading);
		font-weight: var(--font-weight-bold);
		line-height: var(--leading-tight);
	}

	.metric-card__what {
		margin-top: var(--space-1);
		font-size: var(--font-body-sm);
		color: var(--color-foreground);
	}

	.metric-card__source {
		margin-top: var(--space-2);
		font-family: var(--font-family-mono);
		font-size: var(--font-caption);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-cord-tension);
	}
</style>
