---
const navItems = [
	{ label: "Career", href: "/career" },
	{ label: "Internships", href: "/internships" },
	{ label: "Built", href: "/built" },
	{ label: "About", href: "/about" },
	{ label: "Resume", href: "/resume" },
	{ label: "Contact", href: "/contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && (path === href || path.startsWith(`${href}/`));
---

<nav class="rod-nav" aria-label="Primary">
	<div class="rod-nav__rail">
		<span class="rod-nav__node rod-nav__node--brand">
			<a class="rod-nav__link rod-nav__link--brand" href="/">
				Rahul Paul
			</a>
		</span>
		<span class="rod-nav__group">
			{
				navItems.map((item) => (
					<span class="rod-nav__node">
						<a
							class="rod-nav__link"
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
						>
							{item.label}
						</a>
					</span>
				))
			}
		</span>
	</div>
</nav>

<style>
	/* Top rod: a single taut horizontal member. Nav labels are anchor
	   nodes pinned where rod and cord meet — not a conventional navbar
	   with a background fill and rounded pills. */
	.rod-nav {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--color-background);
	}

	.rod-nav__rail {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-10);
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-5) var(--spacing-page-x);
	}

	.rod-nav__group {
		display: flex;
		align-items: center;
		gap: var(--space-10);
	}

	/* Below the six-item rail's natural width, let it scroll horizontally
	   rather than overflow the whole page — the rod stays taut, it just
	   runs past the viewport edge instead of dragging layout with it. */
	@media (max-width: 40rem) {
		.rod-nav__rail {
			justify-content: flex-start;
			gap: var(--space-6);
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
		}

		.rod-nav__group {
			gap: var(--space-6);
		}
	}

	/* The rod itself, running the full width behind the nodes */
	.rod-nav__rail::before {
		content: "";
		position: absolute;
		left: var(--spacing-page-x);
		right: var(--spacing-page-x);
		top: 50%;
		height: 2px;
		background: var(--color-rod-primary);
		transform: translateY(-50%);
	}

	.rod-nav__node {
		position: relative;
		background: var(--color-background);
		padding: 0 var(--space-2);
	}

	.rod-nav__link {
		position: relative;
		display: block;
		font-family: var(--font-family-mono);
		font-size: var(--font-caption);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-foreground);
		text-decoration: none;
	}

	/* Each node is a small filled dot sitting on the rod */
	.rod-nav__link::before {
		content: "";
		position: absolute;
		left: 50%;
		bottom: calc(-1 * var(--space-5) + 1px);
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-rod-primary);
		transform: translateX(-50%);
	}

	.rod-nav__link:hover,
	.rod-nav__link[aria-current="page"] {
		color: var(--color-cord-tension);
	}

	.rod-nav__link:hover::before,
	.rod-nav__link[aria-current="page"]::before {
		background: var(--color-cord-tension);
	}

	/* Brand/wordmark node: same rod-anchored dot, but set in the body
	   typeface at weight to read as identity, not a nav destination. */
	.rod-nav__link--brand {
		font-family: var(--font-family-base);
		font-size: var(--font-body-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: normal;
		text-transform: none;
	}
</style>
