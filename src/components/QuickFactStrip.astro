---
interface Fact {
	label: string;
	value: string;
	pill?: boolean;
}

interface Props {
	facts: Fact[];
}

const { facts } = Astro.props;
---

<ul class="facts__strip">
	{
		facts.map((fact) => (
			<li class="facts__item">
				<span class="facts__leader" aria-hidden="true" />
				<span class="facts__label">{fact.label}</span>
				{fact.pill ? (
					<span class="facts__pill">{fact.value}</span>
				) : (
					<span class="facts__value">{fact.value}</span>
				)}
			</li>
		))
	}
</ul>

<style>
	.facts__strip {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-8);
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 var(--spacing-page-x) var(--space-20);
		list-style: none;
	}

	.facts__item {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-top: var(--space-4);
		min-width: 9rem;
	}

	.facts__leader {
		position: absolute;
		top: 0;
		left: 50%;
		width: 1px;
		height: var(--space-4);
		background: var(--color-rod-secondary);
		transform: translateX(-50%);
	}

	.facts__label {
		font-family: var(--font-family-mono);
		font-size: var(--font-caption);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-muted-foreground);
	}

	.facts__value {
		margin-top: var(--space-1);
		font-size: var(--font-body-sm);
		text-align: center;
	}

	.facts__pill {
		margin-top: var(--space-2);
		padding: var(--space-1) var(--space-4);
		font-size: var(--font-caption);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		border: 1px solid var(--color-cord-tension);
		color: var(--color-cord-tension);
		border-radius: 999px;
	}
</style>
