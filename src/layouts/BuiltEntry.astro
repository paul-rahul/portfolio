---
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title: string;
	summary: string;
}

const { title, summary } = Astro.props;
---

<BaseLayout title={`${title} — Rahul Paul`}>
	<article class="built-entry">
		<h1 class="built-entry__title">{title}</h1>
		<p class="built-entry__summary">{summary}</p>
		<div class="built-entry__body">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.built-entry {
		max-width: 48rem;
		margin: 0 auto;
		padding: var(--space-16) var(--spacing-page-x) var(--space-24);
	}

	.built-entry__title {
		margin: 0 0 var(--space-6);
		font-size: var(--font-heading-xl);
		font-weight: var(--font-weight-bold);
		line-height: var(--leading-tight);
	}

	.built-entry__summary {
		margin: 0 0 var(--space-8);
		font-size: var(--font-body);
		line-height: var(--leading-relaxed);
	}

	.built-entry__body {
		font-size: var(--font-body-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted-foreground);
	}
</style>
