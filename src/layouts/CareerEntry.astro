---
import BaseLayout from "./BaseLayout.astro";
import MetricCard from "../components/MetricCard.astro";

interface Metric {
	value: string;
	whatItMeasured: string;
	source: string;
}

interface Props {
	title: string;
	organization: string;
	dateRange: { start: string; end: string };
	attribution: "direct" | "softened";
	metrics: Metric[];
	summary: string;
}

const { title, organization, dateRange, attribution, metrics, summary } =
	Astro.props;

const dateLabel =
	dateRange.end === "present"
		? `${dateRange.start} — present`
		: `${dateRange.start} — ${dateRange.end}`;
---

<BaseLayout title={`${title}, ${organization} — Rahul Paul`}>
	<article class:list={["entry", { "entry--softened": attribution === "softened" }]}>
		<header class="entry__header">
			<p class="entry__meta">{organization} · {dateLabel}</p>
			<h1 class="entry__title">{title}</h1>
		</header>

		<p class="entry__thesis">{summary}</p>

		{
			attribution === "softened" && (
				<p class="entry__caveat">
					Figures below are attributed at the outcome level (device-line /
					org-wide), not as an individually-isolated personal metric.
				</p>
			)
		}

		<ul class="entry__metrics">
			{
				metrics.map((metric) => (
					<li>
						<MetricCard
							value={metric.value}
							whatItMeasured={metric.whatItMeasured}
							source={metric.source}
						/>
					</li>
				))
			}
		</ul>

		<div class="entry__body">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.entry {
		max-width: 48rem;
		margin: 0 auto;
		padding: var(--space-16) var(--spacing-page-x) var(--space-24);
	}

	.entry__meta {
		margin: 0 0 var(--space-2);
		font-family: var(--font-family-mono);
		font-size: var(--font-caption);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-rod-secondary);
	}

	.entry__title {
		margin: 0 0 var(--space-6);
		font-size: var(--font-heading-xl);
		font-weight: var(--font-weight-bold);
		line-height: var(--leading-tight);
	}

	.entry__thesis {
		margin: 0 0 var(--space-8);
		font-size: var(--font-body);
		line-height: var(--leading-relaxed);
	}

	.entry--softened .entry__caveat {
		margin: calc(-1 * var(--space-4)) 0 var(--space-8);
		font-size: var(--font-body-sm);
		font-style: italic;
		color: var(--color-muted-foreground);
	}

	.entry__metrics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: var(--space-8);
		margin: 0 0 var(--space-16);
		padding: 0;
		list-style: none;
	}

	.entry__body {
		font-size: var(--font-body-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted-foreground);
	}
</style>
