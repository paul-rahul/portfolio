---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="About | Rahul Paul">
	<main class="wrap">
		<PageHero
			chip="About"
			title="Technical enough to go deep. Curious enough to ask why."
			lede="I've moved from building models to deciding which problems deserve a product—and I'm currently sharpening that judgment at Texas McCombs."
		/>
		<section class="editorial-grid">
			<article class="editorial-card large">
				<p class="kicker">The through-line</p>
				<h2 class="editorial-title">I like messy problems with a measurable finish line.</h2>
				<p>My background spans consumer electronics, ad tech, government technology, fantasy sports and AI. The category changes. The work stays familiar: understand the system, find the constraint, and bring people together around a clear outcome.</p>
			</article>
			<article class="editorial-card peach-card">
				<span class="hand-note">currently → Austin, TX</span>
				<h2>Texas McCombs</h2>
				<p>MBA candidate focused on Brand and Product Management, graduating May 2027.</p>
			</article>
			<article class="editorial-card mint-card">
				<h2>Off the clock</h2>
				<p>Competitive enough for badminton. Curious enough to always have a book open. Unapologetically invested in reality TV.</p>
				<div class="mini-tags"><span>Badminton</span><span>Reading</span><span>Reality TV</span></div>
			</article>
			<article class="editorial-card sky-card">
				<h2>How I tend to work</h2>
				<div class="mini-tags"><span>Start with the user</span><span>Interrogate the metric</span><span>Translate the technical</span><span>Ship, learn, sharpen</span></div>
			</article>
		</section>
	</main>
</BaseLayout>
