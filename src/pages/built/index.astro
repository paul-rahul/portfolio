---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Built — Rahul Paul">
	<section class="built-empty">
		<div class="built-empty__rig" aria-hidden="true">
			<span class="built-empty__rod"></span>
			<span class="built-empty__cord"></span>
		</div>
		<p class="built-empty__label">Coming soon</p>
		<h1 class="built-empty__title">Nothing's hanging here yet.</h1>
		<p class="built-empty__body">
			This is where independent, self-directed projects will live —
			each one attributed and traceable the same way Career is. None are
			ready to show yet.
		</p>
	</section>
</BaseLayout>

<style>
	.built-empty {
		position: relative;
		max-width: 36rem;
		margin: 0 auto;
		padding: var(--space-24) var(--spacing-page-x) var(--space-24);
		text-align: center;
	}

	/* A single rod with a cord hanging off it, tension unresolved — the
	   same rig grammar as the home hero, but with no load suspended. */
	.built-empty__rig {
		position: relative;
		height: 6rem;
		margin: 0 auto var(--space-8);
		width: 2px;
	}

	.built-empty__rod {
		position: absolute;
		top: 0;
		left: 0;
		width: 2px;
		height: 60%;
		background: var(--color-rod-primary);
	}

	.built-empty__cord {
		position: absolute;
		top: 60%;
		left: 0;
		width: 1px;
		height: 40%;
		background: var(--color-rod-secondary);
	}

	.built-empty__label {
		margin: 0 0 var(--space-3);
		font-family: var(--font-family-mono);
		font-size: var(--font-caption);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-cord-tension);
	}

	.built-empty__title {
		margin: 0 0 var(--space-4);
		font-size: var(--font-heading-lg);
		font-weight: var(--font-weight-bold);
		line-height: var(--leading-tight);
	}

	.built-empty__body {
		margin: 0;
		font-size: var(--font-body-sm);
		color: var(--color-muted-foreground);
		line-height: var(--leading-relaxed);
	}
</style>
