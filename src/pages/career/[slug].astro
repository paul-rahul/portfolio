---
import { getCollection, render } from "astro:content";
import CareerEntry from "../../layouts/CareerEntry.astro";

export async function getStaticPaths() {
	const entries = await getCollection("career");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<CareerEntry
	title={entry.data.title}
	organization={entry.data.organization}
	dateRange={entry.data.dateRange}
	attribution={entry.data.attribution}
	metrics={entry.data.metrics}
	summary={entry.data.summary}
>
	<Content />
</CareerEntry>
