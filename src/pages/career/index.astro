---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { roles } from "../../data/roles.ts";
---

<BaseLayout title="Career | Rahul Paul">
	<main class="wrap">
		<PageHero
			chip="Career"
			title="A career built at the intersection of models, markets and people."
			lede="Every role below: what I owned, what we built, and the outcome — expand any to see the details."
		/>
		<div class="reading-frame">
			<span class="frame-pill">Problem</span>
			<span class="frame-arrow" aria-hidden="true">→</span>
			<span class="frame-pill">System / product</span>
			<span class="frame-arrow" aria-hidden="true">→</span>
			<span class="frame-pill">User</span>
			<span class="frame-arrow" aria-hidden="true">→</span>
			<span class="frame-pill">Business impact</span>
		</div>
		<section class="career-timeline">
			{
				roles.map((role, i) => (
					<div class="timeline-row">
						<div class="timeline-track">
							<span class="timeline-dot" />
						</div>
						<article class="role-detail" id={role.id} data-role-card>
							<button class="role-toggle" aria-expanded="false" aria-controls={`${role.id}-body`}>
								<div class="role-toggle-heading">
									<h2>{role.company}</h2>
									<span class="role-title">{role.stints[0].title}</span>
									<span class="role-period">{role.period}</span>
								</div>
								<div class="role-toggle-side">
									<span class="role-number">{"0" + (i + 1)}</span>
									<span class="role-toggle-icon" aria-hidden="true">
										<span /><span />
									</span>
								</div>
							</button>
							<div class="role-body" id={`${role.id}-body`}>
								<div class="role-body-inner">
									{role.stints.map((stint) => (
										<div class="stint">
											{role.stints.length > 1 && (
												<div class="stint-heading">
													<h3>{stint.title}</h3>
													<span class="role-period">{stint.period}</span>
												</div>
											)}
											<p class="role-summary">{stint.summary}</p>
											<div class="metric-row">
												{stint.metrics.map(([value, label]) => (
													<div class="metric-tile">
														<b>{value}</b>
														<span>{label}</span>
													</div>
												))}
											</div>
											<ul class="outcome-list">
												{stint.outcomes.map((o) => (
													<li>{o}</li>
												))}
											</ul>
										</div>
									))}
									<div class="role-footer">
										<span>
											{i + 1} / {roles.length}
										</span>
									</div>
								</div>
							</div>
						</article>
					</div>
				))
			}
		</section>
	</main>
</BaseLayout>

<script>
	document.querySelectorAll<HTMLButtonElement>(".role-toggle").forEach((toggle) => {
		toggle.addEventListener("click", () => {
			const card = toggle.closest<HTMLElement>("[data-role-card]");
			const body = card?.querySelector<HTMLElement>(".role-body");
			if (!card || !body) return;
			const expanded = card.classList.toggle("is-expanded");
			toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
			body.style.maxHeight = expanded ? `${body.scrollHeight}px` : "0px";
		});
	});
</script>
