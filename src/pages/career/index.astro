---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { roles } from "../../data/roles.ts";
---

<BaseLayout title="Career | Rahul Paul">
	<main class="wrap">
		<PageHero
			chip="Career"
			title="A career built at the intersection of models, markets and people."
			lede="Every role below: what I owned, what we built, and the outcome — in order, no clicking required."
		/>
		<p class="reading-frame">Problem <span>→</span> System / product <span>→</span> User <span>→</span> Business impact</p>
		<section class="career-shell">
			{
				roles.map((role, i) => (
					<article class="role-detail" id={role.id}>
						<header>
							<div>
								<p>{role.period}</p>
								<h2>{role.company}</h2>
								<span class="role-title">{role.title}</span>
							</div>
							<span class="role-number">{"0" + (i + 1)}</span>
						</header>
						<p class="role-summary">{role.summary}</p>
						<div class="metric-row">
							{role.metrics.map(([value, label]) => (
								<div class="metric-tile">
									<b>{value}</b>
									<span>{label}</span>
								</div>
							))}
						</div>
						<ul class="outcome-list">
							{role.outcomes.map((o) => (
								<li>{o}</li>
							))}
						</ul>
						<div class="role-footer">
							<span>
								{i + 1} / {roles.length}
							</span>
						</div>
					</article>
				))
			}
		</section>
	</main>
</BaseLayout>
