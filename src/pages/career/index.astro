---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { firms } from "../../data/career.ts";
import desktopDarkSvg from "../../assets/how-i-operate/how-i-operate-desktop-dark.svg?raw";
import desktopLightSvg from "../../assets/how-i-operate/how-i-operate-desktop-light.svg?raw";
import tabletDarkSvg from "../../assets/how-i-operate/how-i-operate-tablet-dark.svg?raw";
import tabletLightSvg from "../../assets/how-i-operate/how-i-operate-tablet-light.svg?raw";
import mobileDarkSvg from "../../assets/how-i-operate/how-i-operate-mobile-dark.svg?raw";
import mobileLightSvg from "../../assets/how-i-operate/how-i-operate-mobile-light.svg?raw";

const defaultFirmId = firms[0].id;
---

<BaseLayout title="Career | Rahul Paul">
	<main class="wrap">
		<PageHero title="A career built at the intersection of models, markets and people." />
		<section class="operate-section wrap" aria-labelledby="operate-heading" data-operate-reveal>
			<div class="section-heading">
				<div>
					<h2 id="operate-heading">How I operate.</h2>
				</div>
			</div>

			<div class="how-i-operate-asset how-i-operate--desktop-dark" aria-hidden="true" set:html={desktopDarkSvg} />
			<div class="how-i-operate-asset how-i-operate--desktop-light" aria-hidden="true" set:html={desktopLightSvg} />
			<div class="how-i-operate-asset how-i-operate--tablet-dark" aria-hidden="true" set:html={tabletDarkSvg} />
			<div class="how-i-operate-asset how-i-operate--tablet-light" aria-hidden="true" set:html={tabletLightSvg} />
			<div class="how-i-operate-asset how-i-operate--mobile-dark" aria-hidden="true" set:html={mobileDarkSvg} />
			<div class="how-i-operate-asset how-i-operate--mobile-light" aria-hidden="true" set:html={mobileLightSvg} />

			<ol class="visually-hidden">
				<li>Understand the system</li>
				<li>Find the constraint</li>
				<li>Align the team</li>
				<li>Ship</li>
				<li>Measure</li>
				<li>Seek feedback and iterate back to understanding the system.</li>
			</ol>
		</section>

		<section class="career-explorer" data-career-explorer aria-label="Career explorer">
			<nav class="firm-pane" aria-label="Firms">
				<p class="kicker">Employers</p>
				<ul class="firm-list" role="list">
					{
						firms.map((firm) => (
							<li>
								<button
									type="button"
									class="firm-card"
									data-firm-trigger
									data-firm-id={firm.id}
									aria-pressed={firm.id === defaultFirmId ? "true" : "false"}
									aria-expanded={firm.id === defaultFirmId ? "true" : "false"}
									aria-controls={firm.id}
								>
									<span class="firm-card-name">{firm.name}</span>
									<span class="firm-card-role">{firm.roleSummary}</span>
									<span class="firm-card-period">{firm.period}</span>
									<span class="firm-card-chevron" aria-hidden="true"></span>
								</button>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="firm-detail-pane">
				{
					firms.map((firm) => (
						<div class="firm-detail" data-firm-panel data-firm-id={firm.id} id={firm.id} hidden={firm.id !== defaultFirmId}>
							<header class="firm-detail-head">
								<h2>{firm.name}</h2>
								<p class="firm-detail-meta">{firm.period}</p>
							</header>

							{firm.roles.length > 1 && (
								<div class="role-history">
									<p class="kicker">My roles at {firm.name}</p>
									<ol class="role-history-list" role="list">
										{firm.roles.map((role) => (
											<li class="role-history-item">
												<span class="role-history-dot" aria-hidden="true" />
												<div>
													<div class="role-history-heading">
														<h3>{role.title}</h3>
														<span class="role-history-period">{role.period}</span>
													</div>
													<p>{role.summary}</p>
												</div>
											</li>
										))}
									</ol>
								</div>
							)}

							<div class="project-nav">
								<p class="kicker">Projects at {firm.name}</p>
								<div class="project-selector" role="list">
									{firm.projects.map((project, i) => (
										<button
											type="button"
											class="project-chip"
											data-project-trigger
											data-project-id={project.id}
											aria-pressed={i === 0 ? "true" : "false"}
										>
											<span class="project-chip-title">{project.title}</span>
											<span class="project-chip-desc">{project.descriptor}</span>
											{project.roleLabel && firm.roles.length > 1 && <span class="project-chip-role">{project.roleLabel}</span>}
										</button>
									))}
								</div>
							</div>

							{firm.projects.map((project, i) => (
								<article class="project-detail" data-project-panel data-project-id={project.id} hidden={i !== 0}>
									<header class="project-detail-head">
										<h3>{project.title}</h3>
										<p>{project.summary}</p>
									</header>

									<div class="metric-row">
										{project.metrics.map(([value, label]) => (
											<div class="metric-tile">
												<b>{value}</b>
												<span>{label}</span>
											</div>
										))}
									</div>

									<div class="accordion" data-accordion>
										{project.sections.map((section, si) => {
											const panelId = `${project.id}-${section.id}`;
											const triggerId = `${panelId}-trigger`;
											const isEmpty = !section.paragraphs?.length && !section.bullets?.length;
											return (
												<div class="accordion-item">
													<h4 class="accordion-heading">
														<button
															type="button"
															class="accordion-trigger"
															id={triggerId}
															aria-expanded="false"
															aria-controls={panelId}
														>
															<span class="accordion-number">{String(si + 1).padStart(2, "0")}</span>
															<span class="accordion-title">{section.title}</span>
															<span class="accordion-icon" aria-hidden="true">
																+
															</span>
														</button>
													</h4>
													<div
														class="accordion-panel"
														id={panelId}
														role="region"
														aria-labelledby={triggerId}
														inert
													>
														<div class:list={["accordion-panel-inner", isEmpty && "accordion-panel-inner--empty"]}>
															{section.paragraphs?.map((p) => <p>{p}</p>)}
															{section.bullets && (
																<ul>
																	{section.bullets.map((b) => (
																		<li>{b}</li>
																	))}
																</ul>
															)}
														</div>
													</div>
												</div>
											);
										})}
									</div>
								</article>
							))}
						</div>
					))
				}
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	import { revealOnce } from "../../scripts/motion-reveal.ts";

	const explorer = document.querySelector<HTMLElement>("[data-career-explorer]");
	if (explorer) {
		const firmTriggers = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[data-firm-trigger]"));
		const firmPanels = Array.from(explorer.querySelectorAll<HTMLElement>("[data-firm-panel]"));

		const playEnter = (el: HTMLElement, className: string) => {
			el.classList.remove(className);
			// force reflow so re-adding the class restarts the animation
			void el.offsetWidth;
			el.classList.add(className);
		};

		const firmDetailPane = explorer.querySelector<HTMLElement>(".firm-detail-pane");
		const firmPanelOrder = firmPanels.map((p) => p.dataset.firmId);
		const compactQuery = window.matchMedia("(max-width: 680px)");
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		const getFirmLi = (firmId: string) => {
			const btn = firmTriggers.find((b) => b.dataset.firmId === firmId);
			return btn ? btn.closest("li") : null;
		};

		const getPanel = (firmId: string) => firmPanels.find((p) => p.dataset.firmId === firmId);

		const placePanelInline = (firmId: string) => {
			const li = getFirmLi(firmId);
			const panel = getPanel(firmId);
			if (li && panel && panel.parentElement !== li) li.appendChild(panel);
		};

		const restorePanelToPane = (firmId: string) => {
			if (!firmDetailPane) return;
			const panel = getPanel(firmId);
			if (!panel || panel.parentElement === firmDetailPane) return;
			const idx = firmPanelOrder.indexOf(firmId);
			const nextId = firmPanelOrder[idx + 1];
			const nextPanel = nextId ? getPanel(nextId) : undefined;
			if (nextPanel && nextPanel.parentElement === firmDetailPane) {
				firmDetailPane.insertBefore(panel, nextPanel);
			} else {
				firmDetailPane.appendChild(panel);
			}
		};

		const activateFirm = (firmId: string, { focus = false }: { focus?: boolean } = {}) => {
			firmTriggers.forEach((btn) => {
				const isActive = btn.dataset.firmId === firmId;
				btn.setAttribute("aria-pressed", String(isActive));
				btn.setAttribute("aria-expanded", String(isActive));
				if (isActive && focus) btn.focus();
			});
			firmPanels.forEach((panel) => {
				const isActive = panel.dataset.firmId === firmId;
				const wasHidden = panel.hidden;
				panel.hidden = !isActive;
				if (isActive && wasHidden) playEnter(panel, "motion-firm-enter");
			});
		};

		const setFirmExpandedCompact = (firmId: string, expand: boolean) => {
			const btn = firmTriggers.find((b) => b.dataset.firmId === firmId);
			const panel = getPanel(firmId);
			if (!btn || !panel) return;
			btn.setAttribute("aria-expanded", String(expand));
			btn.setAttribute("aria-pressed", String(expand));
			if (expand) {
				placePanelInline(firmId);
				const wasHidden = panel.hidden;
				panel.hidden = false;
				if (wasHidden) playEnter(panel, "motion-firm-enter");
			} else {
				panel.hidden = true;
				restorePanelToPane(firmId);
			}
		};

		firmTriggers.forEach((btn) => {
			btn.addEventListener("click", () => {
				const id = btn.dataset.firmId;
				if (!id) return;

				if (compactQuery.matches) {
					const wasExpanded = btn.getAttribute("aria-expanded") === "true";
					firmTriggers.forEach((other) => {
						if (other !== btn && other.getAttribute("aria-expanded") === "true") {
							setFirmExpandedCompact(other.dataset.firmId ?? "", false);
						}
					});
					setFirmExpandedCompact(id, !wasExpanded);
					history.replaceState(null, "", wasExpanded ? window.location.pathname : `#${id}`);
					if (!wasExpanded) {
						requestAnimationFrame(() => {
							btn.scrollIntoView({ block: "nearest", behavior: prefersReducedMotion.matches ? "auto" : "smooth" });
						});
					}
				} else {
					activateFirm(id);
					history.replaceState(null, "", `#${id}`);
				}
			});
		});

		// Sync DOM placement of panels when crossing the compact breakpoint,
		// rather than reparenting on every resize event.
		const syncToCompact = () => {
			const expandedBtn = firmTriggers.find((b) => b.getAttribute("aria-expanded") === "true");
			firmTriggers.forEach((btn) => {
				const id = btn.dataset.firmId ?? "";
				const isExpanded = btn === expandedBtn;
				btn.setAttribute("aria-expanded", String(isExpanded));
				if (isExpanded) placePanelInline(id);
			});
		};

		const syncToDesktop = () => {
			firmPanelOrder.forEach((id) => {
				if (id) restorePanelToPane(id);
			});
			// Desktop always shows exactly one panel; fall back to the default
			// firm if compact mode was left with everything collapsed.
			const activeId =
				firmTriggers.find((b) => b.getAttribute("aria-pressed") === "true")?.dataset.firmId ?? firmTriggers[0]?.dataset.firmId;
			firmTriggers.forEach((btn) => {
				const isActive = btn.dataset.firmId === activeId;
				btn.setAttribute("aria-pressed", String(isActive));
				btn.setAttribute("aria-expanded", String(isActive));
			});
			firmPanels.forEach((panel) => {
				panel.hidden = panel.dataset.firmId !== activeId;
			});
		};

		compactQuery.addEventListener("change", (e) => {
			if (e.matches) syncToCompact();
			else syncToDesktop();
		});

		const initialHash = window.location.hash.replace("#", "");
		if (initialHash && firmTriggers.some((b) => b.dataset.firmId === initialHash)) {
			activateFirm(initialHash);
			if (compactQuery.matches) syncToCompact();
		} else if (compactQuery.matches) {
			// Compact/mobile starts with every employer collapsed by default.
			firmTriggers.forEach((btn) => {
				btn.setAttribute("aria-expanded", "false");
				btn.setAttribute("aria-pressed", "false");
			});
			firmPanels.forEach((panel) => {
				panel.hidden = true;
			});
		}

		firmPanels.forEach((panel) => {
			const projectTriggers = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-project-trigger]"));
			const projectPanels = Array.from(panel.querySelectorAll<HTMLElement>("[data-project-panel]"));

			const activateProject = (projectId: string) => {
				projectTriggers.forEach((btn) => btn.setAttribute("aria-pressed", String(btn.dataset.projectId === projectId)));
				projectPanels.forEach((p) => {
					const isActive = p.dataset.projectId === projectId;
					const wasHidden = p.hidden;
					p.hidden = !isActive;
					if (isActive && wasHidden) playEnter(p, "motion-project-enter");
				});
			};

			projectTriggers.forEach((btn) => {
				btn.addEventListener("click", () => {
					const id = btn.dataset.projectId;
					if (!id) return;
					activateProject(id);
				});
			});
		});

		const accordionTriggers = Array.from(explorer.querySelectorAll<HTMLButtonElement>(".accordion-trigger"));
		accordionTriggers.forEach((trigger) => {
			trigger.addEventListener("click", () => {
				const expanded = trigger.getAttribute("aria-expanded") === "true";
				const panel = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
				trigger.setAttribute("aria-expanded", String(!expanded));
				if (panel) {
					panel.classList.toggle("is-open", !expanded);
					if (expanded) {
						panel.setAttribute("inert", "");
					} else {
						panel.removeAttribute("inert");
					}
				}
			});
		});
	}

	revealOnce("[data-operate-reveal]", { asUnit: true });
	revealOnce("[data-career-explorer]");
</script>
