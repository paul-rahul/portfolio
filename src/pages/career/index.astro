---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeaderLink from "../../components/LeaderLink.astro";

const entries = await getCollection("career");
const sorted = entries.sort(
	(a, b) => Date.parse(b.data.dateRange.start) - Date.parse(a.data.dateRange.start),
);
---

<BaseLayout title="Career — Rahul Paul">
	<section class="career-index">
		<h1 class="career-index__title">Career</h1>
		<ul class="career-index__list">
			{
				sorted.map((entry) => (
					<li class="career-index__item">
						<LeaderLink href={`/career/${entry.id}`}>
							<span class="career-index__role">{entry.data.title}</span>
							<span class="career-index__org">{entry.data.organization}</span>
						</LeaderLink>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.career-index {
		max-width: 48rem;
		margin: 0 auto;
		padding: var(--space-16) var(--spacing-page-x) var(--space-24);
	}

	.career-index__title {
		margin: 0 0 var(--space-8);
		font-size: var(--font-heading-xl);
		font-weight: var(--font-weight-bold);
	}

	.career-index__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.career-index__role {
		font-size: var(--font-body);
		font-weight: var(--font-weight-semibold);
	}

	.career-index__org {
		margin-top: var(--space-1);
		font-family: var(--font-family-mono);
		font-size: var(--font-caption);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-rod-secondary);
	}
</style>
