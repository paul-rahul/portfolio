---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryCard from "../../components/EntryCard.astro";

const entries = await getCollection("career");
const sorted = entries.sort(
	(a, b) => Date.parse(b.data.dateRange.start) - Date.parse(a.data.dateRange.start),
);
---

<BaseLayout title="Career — Rahul Paul">
	<section class="career-index">
		<h1 class="career-index__title">Career</h1>
		<div class="career-index__grid">
			{
				sorted.map((entry) => (
					<EntryCard
						href={`/career/${entry.id}`}
						organization={entry.data.organization}
						title={entry.data.title}
						summary={entry.data.summary}
						topMetric={entry.data.metrics[0]}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>

<style>
	.career-index {
		max-width: 64rem;
		margin: 0 auto;
		padding: var(--space-16) var(--spacing-page-x) var(--space-24);
	}

	.career-index__title {
		margin: 0 0 var(--space-8);
		font-size: var(--font-heading-xl);
		font-weight: var(--font-weight-bold);
	}

	.career-index__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: var(--space-6);
	}
</style>
