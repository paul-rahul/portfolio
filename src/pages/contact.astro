---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
---

<BaseLayout title="Contact | Rahul Paul">
	<main class="wrap">
		<PageHero
			chip="Contact"
			title="Let's compare notes."
			lede="For product roles, AI conversations, or a thoughtful exchange on what makes complex products usable."
		/>
		<section class="contact-card">
			<h2>Have a hard product problem?</h2>
			<div class="contact-links">
				<a href="mailto:rahul.paul@my.utexas.edu">
					Email me
					<ArrowIcon size={16} />
				</a>
				<a href="https://www.linkedin.com/in/paul-rahul/" target="_blank" rel="noreferrer">
					LinkedIn
					<ArrowIcon size={16} />
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
