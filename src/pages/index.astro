---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuickFactStrip from "../components/QuickFactStrip.astro";

const quickFacts = [
	{ label: "Background", value: "~6 yrs, ML engineering → product" },
	{ label: "Focus", value: "Post-MBA product management" },
	{ label: "Based in", value: "Austin, TX" },
	{ label: "Status", value: "Open to full-time, 2027", pill: true },
];

const highlights = [
	{
		org: "Dream11",
		headline: "$8M in the first 60 days, in-app ad launch",
		href: "/career/dream11",
	},
	{
		org: "Media.net",
		headline: "$80M revenue, AI-based bid price optimizer",
		href: "/career/medianet-sde",
	},
];
---

<BaseLayout title="Rahul Paul">
	<section class="hero">
		<div class="hero__rig" aria-hidden="true">
			<span class="hero__rod hero__rod--left"></span>
			<span class="hero__rod hero__rod--right"></span>
			<span class="hero__cord hero__cord--left"></span>
			<span class="hero__cord hero__cord--right"></span>
		</div>
		<div class="hero__load">
			<h1 class="hero__name">Rahul Paul</h1>
			<p class="hero__positioning">
				Product manager carrying ~6 years across ML engineering and product,
				building toward full-time PM roles after McCombs.
			</p>
		</div>
	</section>

	<section class="facts" aria-label="Quick facts">
		<QuickFactStrip facts={quickFacts} />
	</section>

	<section class="highlights" aria-label="Highlights">
		<ul class="highlights__list">
			{
				highlights.map((highlight) => (
					<li class="highlights__item">
						<a class="highlights__link" href={highlight.href}>
							<span class="highlights__leader" aria-hidden="true" />
							<span class="highlights__org">{highlight.org}</span>
							<span class="highlights__headline">{highlight.headline}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-24) var(--spacing-page-x) var(--space-16);
		display: flex;
		justify-content: center;
	}

	/* Two rods lean in from corners without touching; two cords in
	   visible tension hold the load between them. Nothing here touches
	   the text mass directly — tension suspends it. */
	.hero__rig {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero__rod {
		position: absolute;
		top: var(--space-12);
		width: 2px;
		height: 40%;
		background: var(--color-rod-primary);
	}

	.hero__rod--left {
		left: 12%;
		transform: rotate(8deg);
		transform-origin: top;
	}

	.hero__rod--right {
		right: 12%;
		transform: rotate(-8deg);
		transform-origin: top;
	}

	.hero__cord {
		position: absolute;
		top: calc(var(--space-12) + 40%);
		width: 1px;
		height: 30%;
		background: var(--color-cord-tension);
	}

	.hero__cord--left {
		left: 12%;
		transform: rotate(-14deg);
		transform-origin: top;
	}

	.hero__cord--right {
		right: 12%;
		transform: rotate(14deg);
		transform-origin: top;
	}

	.hero__load {
		position: relative;
		z-index: 1;
		text-align: center;
		max-width: 36rem;
	}

	.hero__name {
		margin: 0 0 var(--space-3);
		font-size: var(--font-heading-xl);
		font-weight: var(--font-weight-bold);
		line-height: var(--leading-tight);
	}

	.hero__positioning {
		margin: 0;
		font-size: var(--font-body-sm);
		color: var(--color-muted-foreground);
		line-height: var(--leading-relaxed);
	}

	.highlights {
		max-width: 48rem;
		margin: 0 auto;
		padding: 0 var(--spacing-page-x) var(--space-24);
	}

	.highlights__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.highlights__link {
		position: relative;
		display: flex;
		flex-direction: column;
		padding-left: var(--space-5);
		text-decoration: none;
		color: var(--color-foreground);
	}

	.highlights__leader {
		position: absolute;
		left: 0;
		top: 0.35em;
		bottom: 0.35em;
		width: 1px;
		background: var(--color-rod-secondary);
	}

	.highlights__link:hover .highlights__leader {
		background: var(--color-cord-tension);
	}

	.highlights__org {
		font-family: var(--font-family-mono);
		font-size: var(--font-caption);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-rod-secondary);
	}

	.highlights__headline {
		margin-top: var(--space-1);
		font-size: var(--font-body);
		font-weight: var(--font-weight-semibold);
	}
</style>
