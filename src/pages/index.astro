---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";

const facts: [string, string][] = [
	["6+ years", "Engineering → Product"],
	["$135M+", "Revenue influenced"],
	["5 industries", "Consumer Electronics · Ads · GovTech · Fantasy Sports · Networking"],
	["McCombs '27", "MBA"],
];

const capabilities = [
	{
		n: "01",
		name: "0→1 Product Building",
		desc: "Turning ambiguous opportunities into products, launches, and measurable business outcomes.",
	},
	{
		n: "02",
		name: "AI / ML Productization",
		desc: "Translating technically complex systems into usable products, workflows, and decisions.",
	},
	{
		n: "03",
		name: "Monetization & Growth",
		desc: "Connecting product decisions to adoption, experimentation, revenue, and business impact.",
	},
	{
		n: "04",
		name: "Cross functional",
		desc: "Aligning engineering, data, business, and stakeholder teams around clear outcomes.",
	},
];

const projects = [
	{
		imgId: "IMG-02",
		status: "In progress",
		statusTone: "active",
		title: "The first vibe-coded build.",
		desc: "Documenting problem framing, build decisions and what changed after shipping — not just the final screen.",
		cta: "Visit the workshop",
	},
	{
		imgId: "IMG-03",
		status: "Queued",
		statusTone: "queued",
		title: "More builds, queued up.",
		desc: "Additional personal projects are in the pipeline — each gets its own case study once it ships.",
		cta: "See what's next",
	},
];
---

<BaseLayout title="Rahul Paul | Product, AI & ML">
	<main>
		<section class="hero wrap">
			<div class="hero-copy">
				<h1>I build at the intersection of <em>technology, product & market.</em></h1>
				<p class="lede">
					AI/ML engineer turned product manager and product marketer. I turn technical complexity into products
					customers understand, adopt, and businesses can measure.
				</p>
				<div class="actions">
					<a class="button primary" href="/career">
						Explore my work
						<ArrowIcon size={17} />
					</a>
					<a class="button ghost" href="/Rahul_Paul_Resume.pdf" download>Download résumé</a>
				</div>
			</div>
			<div class="hero-art">
				<!-- Placeholder for a real portrait: drop an <img> into .image-frame and remove .intersection-diagram, no other layout changes needed. -->
				<div class="image-frame intersection-diagram" aria-hidden="true">
					<span class="intersection-circle engineering">Engineering</span>
					<span class="intersection-circle design">Design</span>
					<span class="intersection-circle business">Business</span>
					<svg class="intersection-accent" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
						<defs>
							<marker id="intersection-arrowhead" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="3.2" markerHeight="3.2" orient="auto-start-reverse">
								<path d="M0,0 L8,4 L0,8 Z" class="intersection-arrowhead-fill" />
							</marker>
						</defs>
						<path
							class="intersection-arrow"
							d="M89,63 C77,66 63,58 52,46.5"
							fill="none"
							marker-end="url(#intersection-arrowhead)"
						/>
						<circle class="intersection-dot" cx="51" cy="45" r="1.7" />
					</svg>
					<span class="intersection-note">This is me</span>
				</div>
			</div>
		</section>
		<section class="fact-strip wrap" aria-label="Quick facts">
			{facts.map(([big, small]) => <div><strong>{big}</strong><span>{small}</span></div>)}
		</section>
		<section class="capabilities wrap" aria-label="What I'm known for">
			<div class="section-heading">
				<div>
					<p class="kicker">Capabilities</p>
					<h2>What I'm known for.</h2>
				</div>
			</div>
			<div class="capability-grid">
				{
					capabilities.map((c) => (
						<div class="capability-item">
							<span class="capability-number">{c.n}</span>
							<h3>{c.name}</h3>
							<p>{c.desc}</p>
						</div>
					))
				}
			</div>
		</section>
		<section class="work-section wrap">
			<div class="section-heading">
				<div><p class="kicker">Selected projects</p><h2>What I've been working on.</h2></div>
				<a href="/built">
					See Projects
					<ArrowIcon size={16} />
				</a>
			</div>
			<div class="case-grid">
				{
					projects.map((project) => (
						<a class="case-card" href="/built">
							<div class="case-visual">
								<MediaPlaceholder
									id={project.imgId}
									label="Project visual"
									description="Screenshot once shipped"
									aspectRatio="16:10"
								/>
							</div>
							<div class="case-copy">
								<p class={`status-chip status-${project.statusTone}`}>
									<span /> {project.status}
								</p>
								<h3>{project.title}</h3>
								<p class="project-desc">{project.desc}</p>
								<span class="case-link">
									{project.cta}
									<ArrowIcon size={14} />
								</span>
							</div>
						</a>
					))
				}
			</div>
		</section>
		<section class="closing-cta wrap">
			<p>Product judgment, technical depth, and a bias for measurable outcomes.</p>
			<a class="button primary" href="/contact">
				Let's talk
				<ArrowIcon size={17} />
			</a>
		</section>
	</main>
</BaseLayout>

<script>
	const revealOnce = (containerSelector: string, itemsSelector?: string) => {
		const container = document.querySelector<HTMLElement>(containerSelector);
		if (!container || !("IntersectionObserver" in window)) return;
		const items = itemsSelector ? Array.from(container.querySelectorAll<HTMLElement>(itemsSelector)) : Array.from(container.children);
		items.forEach((item) => item.classList.add("motion-pre-reveal"));
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						container.classList.add("is-revealed");
						observer.disconnect();
						break;
					}
				}
			},
			{ threshold: 0.2 },
		);
		observer.observe(container);
	};

	revealOnce(".fact-strip");
	revealOnce(".capability-grid", ".capability-item");
</script>
