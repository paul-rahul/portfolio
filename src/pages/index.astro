---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import QuickFactStrip from "../components/QuickFactStrip.astro";
import EntryCard from "../components/EntryCard.astro";

const quickFacts = [
	{ label: "Background", value: "~6 yrs, ML engineering → product" },
	{ label: "Focus", value: "Post-MBA product management" },
	{ label: "Based in", value: "Austin, TX" },
	{ label: "Status", value: "Open to full-time, 2027", pill: true },
];

const highlightIds = ["dream11", "medianet-sde"];
const career = await getCollection("career");
const highlights = highlightIds
	.map((id) => career.find((entry) => entry.id === id))
	.filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);
---

<BaseLayout title="Rahul Paul">
	<section class="hero">
		<div class="hero__rig" aria-hidden="true">
			<span class="hero__rod hero__rod--left"></span>
			<span class="hero__rod hero__rod--right"></span>
			<span class="hero__cord hero__cord--left"></span>
			<span class="hero__cord hero__cord--right"></span>
		</div>
		<div class="hero__load">
			<h1 class="hero__name">Rahul Paul</h1>
			<p class="hero__positioning">
				Product manager carrying ~6 years across ML engineering and product,
				building toward full-time PM roles after McCombs.
			</p>
		</div>
	</section>

	<section class="facts" aria-label="Quick facts">
		<QuickFactStrip facts={quickFacts} />
	</section>

	<section class="highlights" aria-label="Highlights">
		<div class="highlights__grid">
			{
				highlights.map((entry) => (
					<EntryCard
						href={`/career/${entry.id}`}
						organization={entry.data.organization}
						title={entry.data.title}
						summary={entry.data.summary}
						topMetric={entry.data.metrics[0]}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-24) var(--spacing-page-x) var(--space-16);
		display: flex;
		justify-content: center;
	}

	/* Two rods lean in from corners without touching; two cords in
	   visible tension hold the load between them. Nothing here touches
	   the text mass directly — tension suspends it. */
	.hero__rig {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero__rod {
		position: absolute;
		top: var(--space-12);
		width: 2px;
		height: 40%;
		background: var(--color-rod-primary);
	}

	.hero__rod--left {
		left: 12%;
		transform: rotate(8deg);
		transform-origin: top;
	}

	.hero__rod--right {
		right: 12%;
		transform: rotate(-8deg);
		transform-origin: top;
	}

	.hero__cord {
		position: absolute;
		top: calc(var(--space-12) + 40%);
		width: 1px;
		height: 30%;
		background: var(--color-cord-tension);
	}

	.hero__cord--left {
		left: 12%;
		transform: rotate(-14deg);
		transform-origin: top;
	}

	.hero__cord--right {
		right: 12%;
		transform: rotate(14deg);
		transform-origin: top;
	}

	.hero__load {
		position: relative;
		z-index: 1;
		text-align: center;
		max-width: 36rem;
	}

	.hero__name {
		margin: 0 0 var(--space-3);
		font-size: var(--font-heading-xl);
		font-weight: var(--font-weight-bold);
		line-height: var(--leading-tight);
	}

	.hero__positioning {
		margin: 0;
		font-size: var(--font-body-sm);
		color: var(--color-muted-foreground);
		line-height: var(--leading-relaxed);
	}

	.highlights {
		max-width: 56rem;
		margin: 0 auto;
		padding: 0 var(--spacing-page-x) var(--space-24);
	}

	.highlights__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: var(--space-6);
	}
</style>
