---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import { roles } from "../data/roles.ts";

const facts: [string, string][] = [
	["6+ years", "Across product & ML engineering"],
	["$143M+", "Revenue influenced across roles"],
	["McCombs", "MBA · Brand & Product · May 2027"],
];

const dream11 = roles.find((r) => r.id === "dream11")!;
const medianet = roles.find((r) => r.id === "medianet")!;
---

<BaseLayout title="Rahul Paul | Product, AI & ML">
	<main>
		<section class="hero wrap">
			<div class="hero-copy">
				<p class="eyebrow"><span></span> McCombs MBA · May 2027</p>
				<h1>From modeling data to <em>shaping products.</em></h1>
				<p class="lede">I'm Rahul, a product leader and former ML engineer who turns technical complexity into products people adopt and businesses can measure.</p>
				<div class="actions">
					<a class="button primary" href="/career">
						Explore my work
						<ArrowIcon size={17} />
					</a>
					<a class="button ghost" href="/Rahul_Paul_Resume.pdf" download>Download résumé</a>
				</div>
			</div>
			<div class="hero-art">
				<div class="image-frame peach"><img src="/ml-to-product-clay.jpg" alt="Clay-style illustration of data becoming a product experience" /></div>
				<span class="float-note note-one">ML engineer → PM</span>
				<span class="float-note note-two">AI · Ads · Platforms</span>
			</div>
		</section>
		<section class="fact-strip wrap" aria-label="Quick facts">
			{facts.map(([big, small]) => <div><strong>{big}</strong><span>{small}</span></div>)}
		</section>
		<section class="work-section wrap">
			<div class="section-heading">
				<div><p class="kicker">Selected evidence</p><h2>Work that moved a number.</h2></div>
				<a href="/career">
					Full career
					<ArrowIcon size={16} />
				</a>
			</div>
			<div class="case-grid">
				<a class="case-card lilac" href="/career#dream11">
					<div class="case-image"><img src="/ad-launch-clay.jpg" alt="Clay illustration representing an advertising product launch" /></div>
					<div class="case-copy">
						<p>Dream11 · Product Manager</p>
						<h3>Launched in-app advertising into a new revenue line.</h3>
						<div class="metrics">
							<span><b>{dream11.metrics[0][0]}</b> {dream11.metrics[0][1].toLowerCase()}</span>
							<span><b>{dream11.metrics[1][0]}</b> {dream11.metrics[1][1].toLowerCase()}</span>
						</div>
					</div>
				</a>
				<a class="case-card mint" href="/career#medianet">
					<div class="case-image"><img src="/ml-platform-clay.jpg" alt="Clay illustration representing a machine-learning platform" /></div>
					<div class="case-copy">
						<p>Media.net · Associate Product Manager</p>
						<h3>Made experimentation faster, safer and easier to use.</h3>
						<div class="metrics">
							<span><b>{medianet.metrics[2][0]}</b> experiments / 6 mo.</span>
							<span><b>{medianet.metrics[0][0]}</b> optimizer revenue</span>
						</div>
					</div>
				</a>
			</div>
		</section>
		<section class="closing-cta wrap">
			<p>Product judgment, technical depth, and a bias for measurable outcomes.</p>
			<a class="button primary" href="/contact">
				Let's talk
				<ArrowIcon size={17} />
			</a>
		</section>
	</main>
</BaseLayout>
