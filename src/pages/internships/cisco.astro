---
import { getCollection, render } from "astro:content";
import CareerEntry from "../../layouts/CareerEntry.astro";

const [entry] = await getCollection("internships");
const { Content } = await render(entry);
---

<CareerEntry
	title={entry.data.title}
	organization={entry.data.organization}
	dateRange={entry.data.dateRange}
	attribution={entry.data.attribution}
	metrics={entry.data.metrics}
	summary={entry.data.summary}
>
	<Content />
</CareerEntry>
