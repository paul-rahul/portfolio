---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout title="Internships | Rahul Paul">
	<main class="wrap">
		<PageHero
			chip="Internships"
			title="A summer translating AI capability into market clarity."
			lede="Cisco · Product Marketing MBA Intern · June — August 2026"
		/>
		<article class="feature-card">
			<img src="/experiments-clay.jpg" alt="Clay illustration representing product experimentation" />
			<div class="feature-copy">
				<p class="kicker">Cisco</p>
				<h2>Making AI easier to validate, explain and launch.</h2>
				<p>Built a translation-validation proof of concept, shaped a six-month roadmap with broad stakeholder input, and developed launch messaging for AI sales enablement.</p>
				<div class="metrics"><span><b>15%</b> token reduction</span><span><b>50</b> stakeholders</span><span><b>6 mo.</b> roadmap</span></div>
			</div>
		</article>
	</main>
</BaseLayout>
