---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout title="Internships | Rahul Paul">
	<main class="wrap">
		<PageHero
			chip="Internships"
			title="A summer translating AI capability into market clarity."
			lede="Cisco · Product Marketing MBA Intern · June — August 2026"
		/>
		<section class="career-shell">
			<article class="role-detail">
				<header>
					<div>
						<p>June — August 2026</p>
						<h2>Cisco</h2>
						<span class="role-title">Product Marketing MBA Intern</span>
					</div>
				</header>
				<p class="role-summary">Built a translation-validation proof of concept, shaped a six-month roadmap with broad stakeholder input, and developed launch messaging for AI sales enablement.</p>
				<div class="metric-row">
					<div class="metric-tile"><b>15%</b><span>token reduction</span></div>
					<div class="metric-tile"><b>50</b><span>stakeholders</span></div>
					<div class="metric-tile"><b>6 mo.</b><span>roadmap</span></div>
				</div>
			</article>
		</section>
	</main>
</BaseLayout>

<script>
	import { revealOnce } from "../../scripts/motion-reveal.ts";

	revealOnce(".role-detail", { asUnit: true });
</script>
